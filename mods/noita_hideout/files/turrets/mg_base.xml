<Sprite filename="mods/noita_hideout/files/turrets/mg_base.png" offset_x="16" offset_y="17" default_animation="stand">
    <!-- Draw the entire pedestal behind the world grid so exposed rows follow the terrain. -->
    <RectAnimation name="stand" pos_x="0" pos_y="0" frame_width="32" frame_height="32" frame_count="1" frames_per_row="1" frame_wait="0.1" />
    <RectAnimation name="walk" pos_x="0" pos_y="0" frame_width="32" frame_height="32" frame_count="1" frames_per_row="1" frame_wait="0.1" />
    <!-- The native AI times its shot from the character sprite. Repeat the static base across the gun's four frames. -->
    <RectAnimation name="attack_ranged" pos_x="0" pos_y="0" frame_width="32" frame_height="32" frame_count="4" frames_per_row="4" frame_wait="0.1" loop="0">
        <Event frame="1" name="shoot_bullet" probability="1" />
    </RectAnimation>
</Sprite>
